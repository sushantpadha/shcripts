### global ###
# shared across all script categories

### app ###
# minecraft server (scripts/app/*.sh)
APP_SSH_HOST=1.2.3.4
APP_SSH_USER=user
APP_REMOTE_DIR=/home/user/app
APP_BACKUP_DIR=/mnt/data/backups/mc
# optional: where archives are staged on the server (needs room for a whole world), default /tmp
APP_REMOTE_TMP=/tmp
# optional: process NAME (pgrep) that means "server is running", default java
APP_SERVER_PROCESS=java

### memory ###
# memory logger (scripts/memory/*, utils/memory/*)
MEMORY_WARN_MB=1500
# seconds between snapshots (tray timer). The plot breaks its line after 3x this.
MEMORY_INTERVAL_S=60
# minutes between low-memory popups
MEMORY_WARN_COOLDOWN_MIN=10
# terminal prefix used to show the report from the tray (needs to keep the window open)
MEMORY_TERMINAL="kitty --hold"

### sync ###
# syncdrive (scripts/sync/syncdrive.py). SYNC_TARGET_<n>="name|local dir|remote dir|globs or @filterfile"
# globs: comma-separated, e.g. *.md,*.pdf. @file: rclone filter file inside the local dir.
SYNC_REMOTE=drive-0
SYNC_TARGET_1="docs|/home/user/docs|Docs|*.md,*.pdf"
SYNC_TARGET_2="notes|/home/user/notes|notes|@notes.rclone-filter"
