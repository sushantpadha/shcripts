### global ###
# shared across all script categories

### app ###
# minecraft server (scripts/app/*.sh)
APP_SSH_HOST=1.2.3.4
APP_SSH_USER=user
APP_REMOTE_DIR=/home/user/app
APP_BACKUP_DIR=/mnt/data/backups/mc
# optional: where archives are staged on the server (needs room for a whole world), default /tmp
APP_REMOTE_TMP=/tmp
# optional: process NAME (pgrep) that means "server is running", default java
APP_SERVER_PROCESS=java

### memory ###
# memory logger (scripts/memory/*, utils/memory/*)
MEMORY_WARN_MB=1500
# seconds between snapshots (tray timer). The plot breaks its line after 3x this.
MEMORY_INTERVAL_S=60
# minutes between low-memory popups
MEMORY_WARN_COOLDOWN_MIN=10
# terminal prefix used to show the report from the tray (needs to keep the window open)
MEMORY_TERMINAL="kitty --hold"

### maintenance ###
# clean.sh (scripts/maintenance/clean.sh)
# days of system journal to keep, default 7
MAINTENANCE_JOURNAL_DAYS=7
# age in days after which Downloads items and /tmp files count as old, defaults 90 and 7
MAINTENANCE_DOWNLOADS_DAYS=90
MAINTENANCE_TMP_DAYS=7
# project folders scanned for node_modules / Rust target / __pycache__ (space-separated, no spaces in paths)
MAINTENANCE_PROJECT_DIRS="/home/user/projects /home/user/Documents"
# folders whose size is shown for manual review, never deleted (Downloads, notes, big data, ...)
MAINTENANCE_REVIEW_DIRS="/home/user/Downloads /home/user/Notes /home/user/Documents"
# extra folders with hand-installed programs, listed in the software overview
MAINTENANCE_SOFTWARE_DIRS="/opt/tools /home/user/utils"
# Saved system info: clean.sh refuses to run without it and stops if it does not match this machine.
# Do not write these by hand: run `bash scripts/maintenance/clean.sh --refresh-header` on the machine it is for.
# MAINTENANCE_MACHINE_SAVED="2026-01-01"
# MAINTENANCE_MACHINE_HOST="myhost"
# MAINTENANCE_MACHINE_MODEL="laptop model"
# MAINTENANCE_MACHINE_OS="Ubuntu 24.04 LTS"
# MAINTENANCE_MACHINE_KERNEL="6.8.0-00-generic"
# MAINTENANCE_MACHINE_KERNEL_SUM="kernel build checksum"
# MAINTENANCE_MACHINE_ID_SUM="salted machine id checksum"
# MAINTENANCE_MACHINE_CPU="cpu model"
# MAINTENANCE_MACHINE_RAM_GB="16"
# MAINTENANCE_MACHINE_GPU="gpu model"
# MAINTENANCE_MACHINE_DISKS="nvme0n1 512G"

### sync ###
# syncdrive (scripts/sync/syncdrive.py). SYNC_TARGET_<n>="name|local dir|remote dir|globs or @filterfile"
# globs: comma-separated, e.g. *.md,*.pdf. @file: rclone filter file inside the local dir.
SYNC_REMOTE=drive-0
SYNC_TARGET_1="docs|/home/user/docs|Docs|*.md,*.pdf"
SYNC_TARGET_2="notes|/home/user/notes|notes|@notes.rclone-filter"
